# Django Settings
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False

# Database
MONGODB_URI=mongodb+srv://YOUR-USERNAME:YOUR-PASSWORD@cluster.mongodb.net/YOUR-DATABASE-NAME

# Security Settings for Netlify + Railway
CORS_ALLOWED_ORIGINS=https://your-app-name.netlify.app
ALLOWED_HOSTS=.railway.app,.netlify.app,localhost
